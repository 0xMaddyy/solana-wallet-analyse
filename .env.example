# Helius (or other) Solana JSON-RPC endpoint. Required for most scripts.
SNO_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Optional aliases also accepted by sno.analyze:
# HELIUS_RPC_URL=...
# HELIUS_API_KEY=...

# Pipeline day / wallet list (paths may be absolute, or filenames under config/wallets/)
# SNO_DAY=2026-10-08
# SNO_WALLETS=wallets_sno_pairs.txt
# SNO_TAG=oct8
